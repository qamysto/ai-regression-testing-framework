generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  qa
  developer
  viewer
}

enum ReviewStatus {
  draft
  approved
  rejected
}

enum TestStatus {
  pass
  fail
  skip
  flaky
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole
  comments     Comment[]
}

model Project {
  id                String        @id @default(uuid())
  name              String
  baseUrl           String
  environmentConfig Json          @default("{}")
  requirements      Requirement[]
  testRuns          TestRun[]
}

model Requirement {
  id                 String       @id @default(uuid())
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id])
  title              String
  description        String
  acceptanceCriteria Json
  status             String       @default("draft")
  testCases          TestCase[]
}

model TestSuite {
  id        String     @id @default(uuid())
  projectId String
  name      String
  tags      Json       @default("[]")
  enabled   Boolean    @default(true)
  testCases TestCase[]
}

model TestCase {
  id             String        @id @default(uuid())
  suiteId        String
  suite          TestSuite     @relation(fields: [suiteId], references: [id])
  requirementId  String
  requirement    Requirement  @relation(fields: [requirementId], references: [id])
  title          String
  type           String
  priority       String
  steps          Json
  expectedResult String
  source         String
  reviewStatus   ReviewStatus @default(draft)
  results        TestResult[]
}

model TestRun {
  id           String           @id @default(uuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id])
  trigger      String
  environment  String
  buildId      String?
  status       String
  startedAt    DateTime?
  finishedAt   DateTime?
  results      TestResult[]
  clusters     FailureCluster[]
  releaseReport ReleaseReport?
}

model TestResult {
  id             String       @id @default(uuid())
  runId          String
  run            TestRun      @relation(fields: [runId], references: [id])
  testCaseId     String
  testCase       TestCase     @relation(fields: [testCaseId], references: [id])
  status         TestStatus
  durationMs     Int
  errorMessage   String?
  errorSignature String?
  log            String?
  retries        Int          @default(0)
  artifacts      Artifact[]
  analyses       AiAnalysis[]
}

model Artifact {
  id       String     @id @default(uuid())
  resultId String
  result   TestResult @relation(fields: [resultId], references: [id])
  type     String
  path     String
}

model FailureCluster {
  id        String  @id @default(uuid())
  runId     String
  run       TestRun @relation(fields: [runId], references: [id])
  signature String
  summary   String
  size      Int
}

model AiAnalysis {
  id              String     @id @default(uuid())
  resultId        String
  result          TestResult @relation(fields: [resultId], references: [id])
  category        String
  likelyCause     String
  confidence      Float
  suggestedChecks Json
  model           String
  createdAt       DateTime   @default(now())
}

model Comment {
  id         String   @id @default(uuid())
  targetType String
  targetId   String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  body       String
  createdAt  DateTime @default(now())
  parentId   String?
}

model ReleaseReport {
  id        String  @id @default(uuid())
  runId     String  @unique
  run       TestRun @relation(fields: [runId], references: [id])
  aiSummary String
  risks     Json
  decision  String  @default("pending")
  decidedBy String?
}
